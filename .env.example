# ─────────────────────────────────────────────────────────────────────
#  Coraxis — environment template
#  Copy to `.env` and fill in. Every value has a working default except
#  CORAXIS_SECRET_KEY, which MUST be set before you expose the API.
# ─────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────
CORAXIS_ENV=development                 # development | staging | production
CORAXIS_DEBUG=false
CORAXIS_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
CORAXIS_LOG_JSON=false                  # true for machine-readable logs

# ── Secrets (REQUIRED) ───────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
CORAXIS_SECRET_KEY=
# Optional. A Fernet key used to encrypt provider API keys at rest.
# Leave blank to derive one from CORAXIS_SECRET_KEY (fine for dev; set it
# explicitly in production so you can rotate the signing key independently).
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CORAXIS_ENCRYPTION_KEY=

# ── Database ─────────────────────────────────────────────────────────
# SQLite needs no setup and is the default. Postgres works unchanged:
#   postgresql+asyncpg://coraxis:coraxis@localhost:5432/coraxis
CORAXIS_DATABASE_URL=sqlite+aiosqlite:///./data/coraxis.db

# ── HTTP ─────────────────────────────────────────────────────────────
CORAXIS_HOST=127.0.0.1
CORAXIS_PORT=8000
# Comma-separated allowlist. Never use "*" with credentials enabled.
CORAXIS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Authentication ───────────────────────────────────────────────────
CORAXIS_ACCESS_TOKEN_MINUTES=30
CORAXIS_REFRESH_TOKEN_DAYS=14
CORAXIS_ALLOW_REGISTRATION=true         # set false once your account exists
CORAXIS_JWT_ISSUER=coraxis
CORAXIS_JWT_AUDIENCE=coraxis-api

# ── Firebase Authentication ──────────────────────────────────────
# Firebase owns identity (GitHub OAuth, email/password). The backend verifies
# the Firebase ID token sent as the bearer token on every protected route.
# Create a project in the Firebase console, then:
#   firebase projects:adddefault <project>
# Required:
CORAXIS_FIREBASE_PROJECT_ID=            # e.g. coraxis-research
# Optional: path to a service-account key for verifying tokens locally.
# Leave unset; the Admin SDK fetches public certs with just the project id.
# CORAXIS_GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Firebase client config (frontend) ────────────────────────────────
# Set these in `frontend/.env.local` (or your host's runtime config) from the
# Firebase console → Project settings → General → Your apps → Config snippet.
# They are prefixed NEXT_PUBLIC_ so the browser can read them.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=coraxis-research.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=coraxis-research
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=coraxis-research.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Quotas ───────────────────────────────────────────────────────────
CORAXIS_RATE_LIMIT_ENABLED=true
CORAXIS_RATE_LIMIT_RUNS_PER_HOUR=20
CORAXIS_RATE_LIMIT_REQUESTS_PER_MINUTE=120
CORAXIS_RUN_TIMEOUT_SECONDS=900
CORAXIS_RUN_MAX_CONCURRENT_PER_USER=2

# ── Pipeline defaults ────────────────────────────────────────────────
CORAXIS_MAX_SOURCES=8
CORAXIS_MAX_FETCH_PER_QUERY=5
CORAXIS_MIN_WORD_COUNT=100
CORAXIS_HTTP_TIMEOUT_SECONDS=20
CORAXIS_CREW_MAX_RPM=10

# ── Semantic memory ──────────────────────────────────────────────────
CORAXIS_MEMORY_ENABLED=true
CORAXIS_CHROMA_PATH=./chroma_db
CORAXIS_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Provider keys (OPTIONAL) ─────────────────────────────────────────
# These are fallbacks only. Keys saved per-user through the API are
# encrypted at rest and always take precedence over these.
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
