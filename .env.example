# Coraxis environment variables — API keys (config.json overrides these)
# Copy to .env and fill in what you use.

# Groq (free tier): https://console.groq.com
GROQ_API_KEY=

# Google Gemini: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenAI (optional)
OPENAI_API_KEY=

# Ollama runs locally — no key needed (default base URL http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434
