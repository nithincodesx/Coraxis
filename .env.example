# Kimi Multi-Agent Research Assistant — Environment Variables
# Copy to .env and fill in your keys (optional — keys can also be entered in Settings UI)
# Keys in .env are used as LOCAL DEFAULTS only; UI-entered keys take precedence and live only in session state.

# Groq (free, fast) — get key at https://console.groq.com
GROQ_API_KEY=

# Google Gemini (free tier) — get key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenAI (optional, paid) — get key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Ollama (local, no key needed) — set base URL if not default
# OLLAMA_BASE_URL=http://localhost:11434